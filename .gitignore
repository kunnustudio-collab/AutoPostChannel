# Environment secrets and tokens (CRITICAL)
.env

# SQLite Database and local data
data/*.db
data/*.sqlite
data/*.sqlite3

# Log files
logs/*.log

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Virtual environments
venv/
env/
ENV/
.venv/

# Editor and OS caches
.vscode/
.idea/
.DS_Store
Thumbs.db
