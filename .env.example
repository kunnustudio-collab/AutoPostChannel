# ==========================================
# MedQuiz AI - Environment Configuration Template
# ==========================================

# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# OpenRouter / OpenAI-Compatible API Key
AI_API_KEY=your_ai_api_key_here

# AI Endpoint (default is OpenRouter)
AI_BASE_URL=https://openrouter.ai/api/v1

# Primary AI Model (e.g. meta-llama/llama-3.1-8b-instruct:free or any OpenRouter/OpenAI model)
AI_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Optional Fallback AI Model if primary fails
AI_FALLBACK_MODEL=google/gemini-2.0-flash-lite:free

# AI Generation Parameters
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1000

# Telegram Numeric IDs for Authorized Admins (comma-separated, get from @userinfobot)
ADMIN_IDS=123456789,987654321

# Default Quiz Settings
DEFAULT_LANGUAGE=English
DEFAULT_DIFFICULTY=Medium

# Feature Toggles
ENABLE_VERIFICATION=true
SEND_HEADER_POST=true
SEND_EXPLANATION_POST=true

# API Usage Limits
MAX_GENERATIONS_PER_HOUR=60
MAX_GENERATIONS_PER_DAY=500
